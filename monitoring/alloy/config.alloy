discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
}


discovery.relabel "bcs_containers" {

  targets = discovery.docker.containers.targets

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex = "/(bcs-api|main-postgres|main-loki|main-prometheus|main-grafana|main-n8n)"
    action = "keep"
  }

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex = "/(.*)"
    target_label = "container"
  }
}


loki.source.docker "docker_logs" {

  host = "unix:///var/run/docker.sock"

  targets = discovery.relabel.bcs_containers.output

  forward_to = [
    loki.process.docker_logs.receiver,
  ]
}


loki.process "docker_logs" {

  stage.docker {}

  forward_to = [
    loki.write.default.receiver,
  ]
}


loki.write "default" {

  endpoint {
    url = "http://main-loki:3100/loki/api/v1/push"
  }
}